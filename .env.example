# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Admin (Basic Auth no middleware)
ADMIN_USER=
ADMIN_PASSWORD=

# Ingestão / curadoria — secret que o cron externo manda pra chamar /api/ingest e /api/curar
CRON_SECRET=

# IA (Anthropic). Sem a key, /api/curar e /api/gerar-conteudo respondem 503.
ANTHROPIC_API_KEY=
CURADORIA_MODELO=              # opcional; default claude-opus-5 (baixe p/ claude-sonnet-5 pra cortar custo)
CONTEUDO_MODELO=               # opcional; modelo da geração de conteúdo (default claude-opus-5)

# Shopee Affiliate Open API — aba "Open API" no painel de afiliado
SHOPEE_APP_ID=
SHOPEE_SECRET=
