# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Pexels — fotos lifestyle (livres pra uso comercial) pro FUNDO da capa do carrossel.
# Chave grátis em pexels.com/api. Sem ela, a capa cai no fallback (foto do produto).
PEXELS_API_KEY=

# Instagram — publicação automática no feed (Graph API, Content Publishing).
# Precisa de conta IG Business ligada a uma Página + app com instagram_content_publish
# (App Review da Meta). Use um token de System User (Business Manager) que não expira.
IG_USER_ID=                     # id numérico da conta IG Business
IG_ACCESS_TOKEN=                # token com instagram_content_publish
# URL pública do site (a Meta busca o criativo JPEG em /api/criativo). Default: apex.
NEXT_PUBLIC_SITE_URL=https://pirraiashop.com.br

# Admin (Basic Auth no middleware)
ADMIN_USER=
ADMIN_PASSWORD=

# Ingestão / curadoria — secret que o cron externo manda pra chamar /api/ingest e /api/curar
CRON_SECRET=

# IA (OpenAI). Sem a key, /api/curar e /api/gerar-conteudo respondem 503.
OPENAI_API_KEY=
CURADORIA_MODELO=              # opcional; default gpt-4.1-mini (barato; gpt-4.1-nano corta mais)
CONTEUDO_MODELO=               # opcional; default gpt-4.1 (copy do post)

# Shopee Affiliate Open API — aba "Open API" no painel de afiliado
SHOPEE_APP_ID=
SHOPEE_SECRET=

# AliExpress Open Platform — API de afiliado (aliexpress.affiliate.*).
# App Key/Secret em openservice.aliexpress.com (app aprovado p/ afiliado).
# Sem OAuth: a assinatura app-level (key+secret) basta pra buscar e gerar link.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# tracking_id do painel de afiliado (portals.aliexpress.com → Ad Center). É o
# "sub-id": atribui a comissão e é OBRIGATÓRIO pra gerar link de afiliado.
ALIEXPRESS_TRACKING_ID=

# Mercado Livre — a busca fechou o acesso anônimo (volta 403 sem token).
# App em developers.mercadolivre.com.br → o app pega/renova o token sozinho
# (grant client_credentials). É o que a ingestão usa em produção.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Opcional: token cru pra teste rápido (expira ~6h). Se preenchido, tem prioridade.
MERCADOLIVRE_TOKEN=
